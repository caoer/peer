{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The peer protocol's Worker (src/index.ts): the relay at /peer on
	// peer.0xtau.com, on the caoer account. Secrets: RELAY_LOGIN.
	"name": "peer",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// reader/index.html is imported as text by src/reader.ts and served at /.
	"rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
	"observability": { "enabled": true },
	// The zone has no record for the name; the custom domain creates it.
	"routes": [{ "pattern": "peer.0xtau.com", "custom_domain": true }],
	// Every /peer request, keyed on CF-Connecting-IP, before anything wakes —
	// the wire contract's 100 requests per 10 s. The namespace id is local to
	// the deploying account; any integer serves.
	"ratelimits": [
		{
			"name": "PEER_HITS",
			"namespace_id": "1009",
			"simple": { "limit": 100, "period": 10 }
		}
	],
	// One instance per channel, named `p/<id>`, and one per room, named `r/<id>`.
	"durable_objects": {
		"bindings": [
			{
				"name": "PEER_CHANNEL",
				"class_name": "PeerChannel"
			},
			{
				"name": "PEER_ROOM",
				"class_name": "PeerRoom"
			}
		]
	},
	// Cloudflare refuses to roll a deploy back past a migration that adds a
	// class: forward only.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PeerChannel"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["PeerRoom"]
		}
	]
}
